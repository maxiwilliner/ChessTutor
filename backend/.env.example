# Configuración de ChessTutor Backend

# User-Agent requerido por Chess.com (indica tu contacto/email o usuario)
CHESSCOM_USER_AGENT=ChessTutor/1.0 (tu-email@dominio.com)

# Ruta al ejecutable de Stockfish (opcional si está en backend/bin/stockfish o en el PATH del sistema)
# STOCKFISH_PATH=/usr/games/stockfish

# API Keys para el Tutor Pedagógico (Opcionales: si no se configuran, el tutor usa heurísticas deterministicas integradas)
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...

# Concurrencia y límites del motor Stockfish
STOCKFISH_CONCURRENCY=2
STOCKFISH_DEPTH_FAST=11
STOCKFISH_DEPTH_DEEP=15

