# ====================================
# ChessTutor - Git Ignore
# ====================================

# Environments & Virtualenvs
backend/.venv/
.venv/
venv/
env/
ENV/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Node.js & Next.js
node_modules/
frontend/node_modules/
frontend/.next/
.next/
frontend/out/
build/
dist/
*.tsbuildinfo
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Databases & Cache Data
backend/*.db
backend/*.db-wal
backend/*.db-shm
*.sqlite
*.sqlite3
*.db

# Heavy Binaries (Stockfish ~40MB)
backend/bin/*
!backend/bin/.gitkeep
bin/*
!bin/.gitkeep

# Secrets & Environment Variables (NEVER COMMIT)
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.cert

# Operating System & IDEs
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

