# Cloudflare Pages / Netlify. Las reglas que coinciden se combinan.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://images.chesscomfiles.com; font-src 'self'; connect-src 'self' https://api.chess.com https://cloudflareinsights.com https://*.ingest.sentry.io https://*.ingest.de.sentry.io https://*.ingest.us.sentry.io; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

# El motor no cambia entre despliegues de la misma versión (el nombre del archivo incluye la versión)
/engine/*
  Cache-Control: public, max-age=31536000, immutable

# Los archivos de /_next/static llevan hash en el nombre: nunca cambian
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Ejemplo pre-analizado: se regenera con cada versión del análisis
/example/*
  Cache-Control: public, max-age=3600
